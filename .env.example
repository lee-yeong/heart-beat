# 복사해서 .env.local로 만들고 값을 채우세요. .env.local은 절대 커밋하지 않습니다.

# Anthropic Claude API 키 (서버 전용). console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# 사용할 모델 ID
AI_MODEL=claude-sonnet-5-5

# Supabase 프로젝트 URL. Integrations → Data API
NEXT_PUBLIC_SUPABASE_URL=
# Supabase service_role 키 (서버 전용, 공개 금지). Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=

# 시연 모드. true면 /demo에서 시드 계정으로 로그인 가능
DEMO_MODE=true
# /demo 진입 비밀코드 (서버 전용)
DEMO_ACCESS_SECRET=
